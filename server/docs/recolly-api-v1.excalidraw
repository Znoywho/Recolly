   "seed": 1475774561,
   "version": 1,
   "versionNonce": 1706653184,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793180000000,
   "link": null,
   "locked": false,
   "text": "G4 · giải quyết xung đột: keep = google → chép bản Google vào local, synced. keep = local → lấy etag MỚI NHẤT của Google,\nstatus = pending → lần sync sau patch với If-Match mới nên thành công.",
   "fontSize": 14,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d886eedc4607d37ef748",
   "originalText": "G4 · giải quyết xung đột: keep = google → chép bản Google vào local, synced. keep = local → lấy etag MỚI NHẤT của Google,\nstatus = pending → lần sync sau patch với If-Match mới nên thành công.",
   "autoResize": true,
   "lineHeight": 1.25
  },
