   "text": "Process C(t) = cos(2π(t − φ) / 24) · H⁺ = 0.67 + 0.12·C · H⁻ =\n0.17 + 0.12·C",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "94727855ddb5b1c9c8c0",
   "originalText": "Process C(t) = cos(2π(t − φ) / 24) · H⁺ = 0.67 + 0.12·C · H⁻ =\n0.17 + 0.12·C",
   "autoResize": true,
   "lineHeight": 1.25
