# Server settings, read by app/config.py. Copy to server/.env (git-ignored) and fill in.
POSTGRES_DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5433/recolly_db

# Backend JWTs. Any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google Cloud "Web application" OAuth client (its ID is Flutter's serverClientId).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty for Android server auth codes.
GOOGLE_REDIRECT_URI=
# Encrypts stored Google refresh tokens:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Public HTTPS URL for Google push notifications (two-way sync), e.g. a cloudflared tunnel.
WEBHOOK_BASE_URL=

# Optional; only reported by GET /api/v1/health.
REDIS_URL=
